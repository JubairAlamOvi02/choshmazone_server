# Choshmazone Client Environment Variables
# In production on VPS, leave VITE_API_URL empty when served behind Nginx reverse proxy
VITE_API_URL=

# Real-time Phone Push Notifications via ntfy (Zero-cost iOS & Android lockscreen alerts)
VITE_NTFY_TOPIC=choshmazone-orders-change-this-to-a-secret-topic

# Telegram Bot Instant Order Alerts (Optional fallback / companion alerts)
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id

# Public URL of the Admin Panel (used in action buttons for Telegram and ntfy notifications)
VITE_ADMIN_BASE_URL=https://yourdomain.com/admin/orders
