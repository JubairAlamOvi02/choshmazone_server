PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL on VPS)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=choshmazone
DB_USER=choshma_user
DB_PASSWORD=your_secure_db_password

# Or connection string:
# DATABASE_URL=postgresql://choshma_user:your_secure_db_password@localhost:5432/choshmazone

# JWT Secret for User & Admin authentication
JWT_SECRET=choshmazone_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Base Domain URL for Facebook Catalog XML Feed and Media Links
BASE_URL=https://choshmazone.com

# Optional external integrations
GOOGLE_SCRIPT_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
